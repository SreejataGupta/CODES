import java.util.Arrays;

class Solution {
    public double trimMean(int[] arr) {
        // Step 1: Sort the array
        Arrays.sort(arr);
        
        // Step 2: Calculate 5% offset count
        int n = arr.length;
        int k = n / 20; // 5% of n is n / 20
        
        // Step 3: Sum the remaining 90% of elements
        double sum = 0;
        for (int i = k; i < n - k; i++) {
            sum += arr[i];
        }
        
        // Step 4: Return average of middle elements
        return sum / (n - 2 * k);
    }
}
