class Solution {
    public int[] searchRange(int[] nums, int target) {
        int n = nums.length;
        int lb = lowerBound(nums, n, target);
        
        // If element is not present or lower bound index exceeds bounds
        if (lb == n || nums[lb] != target) {
            return new int[]{-1, -1};
        }
        
        // Upper Bound gives first element > target, so subtract 1 for last position
        return new int[]{lb, upperBound(nums, n, target) - 1};
    }

    private int lowerBound(int[] arr, int n, int x) {
        int low = 0, high = n - 1;
        int ans = n;

        while (low <= high) {
            int mid = low + (high - low) / 2;
            // lower bound condition: arr[mid] >= x
            if (arr[mid] >= x) {
                ans = mid;
                high = mid - 1; // Look for smaller index on the left
            } else {
                low = mid + 1;  // Look right
            }
        }
        return ans;
    }

    private int upperBound(int[] arr, int n, int x) {
        int low = 0, high = n - 1;
        int ans = n;

        while (low <= high) {
            int mid = low + (high - low) / 2;
            // upper bound condition: arr[mid] > x
            if (arr[mid] > x) {
                ans = mid;
                high = mid - 1; // Look for smaller index on the left
            } else {
                low = mid + 1;  // Look right
            }
        }
        return ans;
    }
}
