class Solution {
    public int singleNonDuplicate(int[] nums) {
        int n = nums.length;

        // Edge cases: single-element array or target at the ends
        if (n == 1) return nums[0];
        if (nums[0] != nums[1]) return nums[0];
        if (nums[n - 1] != nums[n - 2]) return nums[n - 1];

        // Search space bounded between index 1 and n - 2 to prevent out-of-bounds access
        int low = 1, high = n - 2;

        while (low <= high) {
            int mid = low + (high - low) / 2;

            // Found the single element (it matches neither neighbor)
            if (nums[mid] != nums[mid - 1] && nums[mid] != nums[mid + 1]) {
                return nums[mid];
            }

            // Check if we are in the left half: (even, odd) index pairing pattern
            if ((mid % 2 == 1 && nums[mid] == nums[mid - 1]) || 
                (mid % 2 == 0 && nums[mid] == nums[mid + 1])) {
                low = mid + 1; // Eliminate left half
            } 
            // We are in the right half: (odd, even) index pairing pattern
            else {
                high = mid - 1; // Eliminate right half
            }
        }

        return -1;
    }
}
