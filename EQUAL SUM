class Solution {
    public int pivotIndex(int[] nums) {
        // Step 1: Compute total sum of the entire array
        int totalSum = 0;
        for (int num : nums) {
            totalSum += num;
        }

        // Step 2: Track running left sum as we iterate
        int leftSum = 0;

        for (int i = 0; i < nums.length; i++) {
            // Calculate right sum on the fly
            int rightSum = totalSum - leftSum - nums[i];

            // If left sum equals right sum, we found the pivot index!
            if (leftSum == rightSum) {
                return i;
            }

            // Update left sum for the next iteration
            leftSum += nums[i];
        }

        return -1; // No pivot index found
    }
}
