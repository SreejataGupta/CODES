import java.util.Arrays;

class Solution {
    public int thirdMax(int[] nums) {
        // Sort the array in ascending order
        Arrays.sort(nums);
        
        int n = nums.length;
        int distinctCount = 1;
        
        // Traverse backwards from the largest element
        for (int i = n - 2; i >= 0; i--) {
            // Check if the current element is distinct from the previous one
            if (nums[i] != nums[i + 1]) {
                distinctCount++;
            }
            // If we found the 3rd distinct maximum, return it
            if (distinctCount == 3) {
                return nums[i];
            }
        }
        
        // If there are fewer than 3 distinct numbers, return the maximum element (last element)
        return nums[n - 1];
    }
}
