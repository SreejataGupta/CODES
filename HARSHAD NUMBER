class Solution {
    public int sumOfTheDigitsOfHarshadNumber(int x) {
        if (x <= 0) return -1;
        
        int temp = x;
        int sum = 0;
        
        while (temp > 0) {
            sum += temp % 10;
            temp /= 10;
        }
        
        // If x is divisible by the sum of its digits, return the sum. Otherwise, return -1.
        if (x % sum == 0) {
            return sum;
        } else {
            return -1;
        }
    }
}
