class Solution {
    public boolean checkPerfectNumber(int num) {
        // Perfect numbers must be greater than 1
        if (num <= 1) {
            return false;
        }

        int sum = 1; // 1 is always a proper divisor for num > 1

        // Loop up to the square root of num
        for (int i = 2; i * i <= num; i++) {
            if (num % i == 0) {
                sum += i;
                // Add the paired divisor if it's different from i
                if (i * i != num) {
                    sum += num / i;
                }
            }
        }

        return sum == num;
    }
}
