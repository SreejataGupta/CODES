import java.util.Arrays;

public class RearrangeArrayOptimal {

    public static int[] rearrangeArray(int[] nums) {
        int[] result = new int[nums.length];
        int posIndex = 0; // Positives go to even indices: 0, 2, 4, ...
        int negIndex = 1; // Negatives go to odd indices: 1, 3, 5, ...

        // Single pass to place elements directly into their final positions
        for (int num : nums) {
            if (num > 0) {
                result[posIndex] = num;
                posIndex += 2;
            } else {
                result[negIndex] = num;
                negIndex += 2;
            }
        }

        return result;
    }

    public static void main(String[] args) {
        int[] nums = {-4, 4, -4, 4, -4, 4};
        int[] output = rearrangeArray(nums);

        System.out.println("Input:  " + Arrays.toString(nums));
        System.out.println("Output: " + Arrays.toString(output));
    }
}
