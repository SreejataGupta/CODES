class Solution {
    public void pattern11(int n) {
        for (int i = 1; i <= n; i++) {
            // If the row number is odd, start with 1; if even, start with 0
            int start = (i % 2 != 0) ? 1 : 0;
            
            for (int j = 1; j <= i; j++) {
                System.out.print(start + " ");
                // Toggle start between 1 and 0 for the next column
                start = 1 - start;
            }
            System.out.println();
        }
    }
}
